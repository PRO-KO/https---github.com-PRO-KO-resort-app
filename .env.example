# ── 안전보건공단 발전기금 휴양소 예약 시스템 환경 변수 ──────────────────────
# 이 파일을 복사하여 .env 파일을 생성한 후 실제 값을 입력하세요.
#   cp .env.example .env
# 주의: .env 파일은 절대 git에 커밋하지 마세요.

# ── 관리자 비밀번호 (VITE_ 접두사 = 프론트엔드에서 읽을 수 있음) ─────────────
VITE_ADMIN_PW=여기에_강력한_비밀번호_입력

# ── 선택: Anthropic API 키 (메일 발송 기능 사용 시만 필요) ────────────────────
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ═════════════════════════════════════════════════════════════════════════════
# ── DB 연동 시 추가 환경변수 (server/index.js 에서 사용) ─────────────────────
# ═════════════════════════════════════════════════════════════════════════════

# DB 타입: oracle 또는 tibero
DB_TYPE=oracle

# Oracle 연결 (호스트:포트/서비스명)
DB_HOST=192.168.1.100:1521/ORCL
DB_USER=RESORT_APP
DB_PASSWORD=강력한비밀번호로변경

# Tibero 전용 (DB_TYPE=tibero 일 때 사용)
# DB_TIBERO_DSN=TIBERO_DSN   ← ODBC 데이터 원본 이름
# DB_PORT=8629
# DB_NAME=tibero

# JWT 서명 키 (32자 이상 무작위 문자열 필수)
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_MINIMUM_32_CHARACTERS

# API 서버 포트 (Nginx 리버스 프록시로 80/443에 연결)
PORT=4000

# production 으로 설정하면 CORS 차단 및 에러 상세 숨김
NODE_ENV=development
